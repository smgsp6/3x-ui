# Copy to <VELA_HOME>/.env (mode 0600). Never commit real values.
# Run Vela only after confirming a public HTTPS reverse proxy and BotFather Mini App setup.
XUI_TG_MINIAPP_ADMIN_IDS=123456789
XUI_TG_MINIAPP_URL=https://vela.example.com/
TZ=Asia/Tokyo
# Vela panel listen port inside host-network container; configure HTTPS reverse proxy for it.
XUI_PORT=2053

# Optional: deliver generic certificate warnings to private Telegram admin IDs.
# No certificate names, node IPs or filesystem paths are sent.
XUI_TG_CERT_ALERT_ENABLED=false
